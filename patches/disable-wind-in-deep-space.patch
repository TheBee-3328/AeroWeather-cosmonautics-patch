+        // Cosmonautics' Moon and deep-space dimensions have no normal
+        // atmosphere, so AeroWeather must not apply atmospheric wind forces there.
+        ResourceLocation dimension = level.dimension().location();
+        if (dimension.getNamespace().equals("rocketnautics")
+                && (dimension.getPath().equals("deep_space") || dimension.getPath().equals("moon"))) {
+            return;
+        }
+
